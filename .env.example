# Frontend API endpoint
VITE_METRICS_API=/api

# New Relic Configuration
# Get these values from: https://one.newrelic.com/

# License Key - Para el agente de infraestructura
# Go to: Administration > API Keys > Ingest - License
NEW_RELIC_LICENSE_KEY=your_license_key_here

# Account ID - ID de tu cuenta de New Relic
# Lo encuentras en la URL: https://one.newrelic.com/accounts/{ACCOUNT_ID}
NEW_RELIC_ACCOUNT_ID=your_account_id_here

# API Key - Para queries GraphQL/NerdGraph
# Go to: Administration > API Keys > User Key (create one with NerdGraph access)
NEW_RELIC_API_KEY=your_api_key_here

# Optional: New Relic region for NerdGraph endpoint fallback (us/eu)
NEW_RELIC_REGION=eu

# Optional: widen NRQL search window if data arrives with delay
METRICS_LOOKBACK_MINUTES=5
